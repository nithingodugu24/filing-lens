# Docker Compose defaults work without credentials. Copy this file to .env.
POSTGRES_PASSWORD=local-demo-password
# For a host Python server against the Compose database:
DATABASE_URL=postgresql+psycopg://filinglens:local-demo-password@127.0.0.1:5438/filinglens
STORAGE_DIR=data/documents
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=hash-v1
EMBEDDING_DIMENSIONS=256
ANSWER_PROVIDER=extractive
ANSWER_MODEL=
PROVIDER_API_KEY=
PROVIDER_BASE_URL=https://api.openai.com/v1
# Optional USD per million tokens. Leave absent unless you supply pricing.
# INPUT_COST_PER_MILLION=0
# OUTPUT_COST_PER_MILLION=0
