APP_ENV=development
# Docker Compose defaults work without credentials. Copy this file to .env.
POSTGRES_PASSWORD=local-demo-password
# For a host Python server against the Compose database:
DATABASE_URL=postgresql+psycopg://filinglens:local-demo-password@127.0.0.1:5438/filinglens
STORAGE_DIR=data/documents
# PDF payload limit in MiB (1–100); the interface reads this from the API.
MAX_UPLOAD_MB=100
# Processing budgets apply after normalising extra PDF spacing.
MAX_PDF_PAGES=750
MAX_PAGE_TEXT_CHARS=250000
MAX_DOCUMENT_TEXT_CHARS=10000000
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=hash-v1
EMBEDDING_DIMENSIONS=256
ANSWER_PROVIDER=extractive
ANSWER_MODEL=
# Optional local models (requires installing [ml] or Docker INSTALL_ML=true).
# EMBEDDING_PROVIDER=sentence-transformer
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384
# FinBERT mean-pooling experiment: ProsusAI/finbert, dimensions 768.
# Changing embeddings requires reindexing; existing reviews are reset by reindexing.
INSTALL_ML=false
SENTIMENT_ENABLED=false
NER_ENABLED=false
# Optional Gemini: set ANSWER_PROVIDER=gemini, then provide your key below.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional accounts: a secret of at least 32 characters enables sign-in.
# Development only: the first registered account becomes admin and inherits local reports.
# Production uses deliberate admin setup; see docs/PRODUCTION_SETUP.md.
# Set explicit HTTPS origins for production:
# CORS_ORIGINS=https://your-app-domain
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PROVIDER_API_KEY=
PROVIDER_BASE_URL=https://api.openai.com/v1
# For a compatible service such as River, set ANSWER_PROVIDER=openai,
# ANSWER_MODEL to an ID from that service, and PROVIDER_BASE_URL to its /v1 endpoint.
# Example model on River: deepseek-ai/DeepSeek-V4.1-Flash
PROVIDER_MAX_OUTPUT_TOKENS=2048
PROVIDER_TIMEOUT=30
# Optional service-specific control. River DeepSeek supports "none" for quick answers.
PROVIDER_REASONING_EFFORT=
# Optional USD per million tokens. Leave absent unless you supply pricing.
# INPUT_COST_PER_MILLION=0
# OUTPUT_COST_PER_MILLION=0
